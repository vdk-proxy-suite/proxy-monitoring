{
  "host_id": "example-host",
  "database": "state/monitor.db",
  "poll_seconds": 15,
  "retention_days": 7,
  "sources": [
    {"id": "host", "kind": "host", "mountpoints": ["/"]},
    {
      "id": "telemt-direct",
      "kind": "telemt",
      "instance": "direct",
      "unit": "telemt-direct.service",
      "metrics_url": "http://127.0.0.1:19090/metrics",
      "ports": [1110]
    },
    {
      "id": "3proxy-main",
      "kind": "3proxy",
      "instance": "main",
      "unit": "3proxy-main.service",
      "log_glob": "/var/log/3proxy-setup/instances/main/*.log*",
      "ports": [1080, 1081, 1082, 1083, 8080, 8081, 8082, 8083, 8443, 8444, 8445, 8446],
      "log_timezone": "UTC",
      "byte_semantics": "unknown"
    }
  ]
}
